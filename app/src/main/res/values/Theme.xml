    </style>
    <style name="AlertDialog.NeutralBtn" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:background">@drawable/rounded_background</item>
        <item name="android:textColor">@color/colorButtonTextEnabled</item>
    </style>
</resources>
